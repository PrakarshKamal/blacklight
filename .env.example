# Copy to .env.local and fill in values. All variables are optional.

# Enables the LLM analysis layer. Without it, scans run on regex + extraction/OCR only.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional. Absolute base URL of the app, used as a fallback when reading bundled
# sample files. Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000
